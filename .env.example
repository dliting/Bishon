# Bishon V2 configuration template.
# Copy to .env and edit before first run. Never commit your real .env.

# --- LLM (OpenAI-compatible API) ---
OPENAI_API_KEY=EMPTY
# ⚠ Docker bridge 模式下 localhost 不可达宿主机服务, 必须改为实际 IP!
#   Docker bridge (same host): http://172.17.0.1:8000/v1  (Docker bridge IP)
#   Docker host (same host):   http://localhost:8000/v1    (shares host network)
#   Remote:                   http://<ip>:8000/v1
OPENAI_API_BASE=http://localhost:8000/v1
OPENAI_API_MODEL_NAME=Qwen3.5-4B
OPENAI_API_CONTEXT_LENGTH=32768
LLM_PROVIDER=openai

# --- Embedding (OpenAI-compatible API) ---
EMBEDDING_API_KEY=EMPTY
# ⚠ Docker bridge 模式下 localhost 不可达宿主机服务, 必须改为实际 IP!
# Code strips trailing /embeddings before calling GET /v1/models.
EMBEDDING_API_BASE=http://localhost:8001/v1/embeddings
EMBEDDING_MODEL_NAME=Qwen3-Embedding-0.6B

# --- Models directory ---
# In Docker mode, entrypoint.sh sets MODELS_DIR=/opt/bishon-home/models.
# In bare-metal mode, this defaults to <project_root>/models/.
# Override only if your models are in a non-standard location.
# MODELS_DIR=/opt/bishon-home/models

# --- Document relevance ---
DOC_SCORE_THRESHOLD=0.65

# --- Rerank (in-process, Qwen3-Reranker-0.6B) ---
# Relative paths are resolved against MODELS_DIR (or root_path/models/ by default).
RERANK_MODEL_PATH=Qwen3-Reranker-0.6B
RERANK_ENABLED=false

# --- GPU acceleration (set to false to force CPU) ---
VECTOR_DB_USE_GPU=true
RERANK_USE_GPU=true
OCR_USE_GPU=true

# --- FAISS dimension (must match your embedding model output) ---
# qwen3-embedding:0.6b -> 1024; nomic-embed-text -> 768; bge-m3 -> 1024
FAISS_EMBEDDING_DIM=1024

# --- System ---
USER_IP=localhost
