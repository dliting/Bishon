# Bishon V2 configuration template.
# Copy to .env and edit before first run. Never commit your real .env.

# --- LLM (OpenAI-compatible API) ---
OPENAI_API_KEY=EMPTY
# Ollama address. Adjust based on your deployment:
#   Linux/macOS bare-metal: http://localhost:11434/v1
#   Docker (Ollama on host): http://host.docker.internal:11434/v1
#   Remote Ollama/API: http://<ip>:11434/v1
#   WSL (Ollama on Windows): depends on networking mode —
#     NAT mode (default): localhost does NOT reach Windows; use the gateway IP:
#       WSL_GATEWAY=$(ip route show default | awk '{print $3}')  # e.g. 172.23.16.1
#       OPENAI_API_BASE=http://$WSL_GATEWAY:11434/v1
#     Mirrored mode (.wslconfig networkingMode=mirrored): http://localhost:11434/v1 works.
OPENAI_API_BASE=http://localhost:11434/v1
OPENAI_API_MODEL_NAME=qwen3:8b
OPENAI_API_CONTEXT_LENGTH=32768
LLM_PROVIDER=openai

# --- Embedding (OpenAI-compatible API) ---
EMBEDDING_API_KEY=EMPTY
# Must point at the same host as OPENAI_API_BASE (same NAT/gateway rules apply;
# the code strips the trailing /embeddings before calling GET /v1/models).
EMBEDDING_API_BASE=http://localhost:11434/v1/embeddings
EMBEDDING_MODEL_NAME=qwen3-embedding:0.6b

# --- Document relevance ---
DOC_SCORE_THRESHOLD=0.65

# --- Rerank (in-process, Qwen3-Reranker-0.6B) ---
RERANK_MODEL_PATH=./models/Qwen3-Reranker-0.6B
RERANK_ENABLED=false

# --- GPU acceleration (set to false to force CPU) ---
VECTOR_DB_USE_GPU=true
RERANK_USE_GPU=true
OCR_USE_GPU=true

# --- FAISS dimension (must match your embedding model output) ---
# qwen3-embedding:0.6b -> 1024; nomic-embed-text -> 768; bge-m3 -> 1024
FAISS_EMBEDDING_DIM=1024

# --- System ---
USER_IP=localhost
