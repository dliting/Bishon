# Bishon V2 frontend environment template.
# Copy to .env.development or .env.production and edit.
# These files (.env.*) are gitignored; only .env.example is tracked.

# Empty = relative path (works for both local and remote access).
# Set to http://localhost:8777 only if frontend is served from a different origin.
VITE_APP_API_HOST=
VITE_APP_API_PREFIX=/api
VITE_APP_WEB_PREFIX=/bishon
VITE_APP_MODE=dev
